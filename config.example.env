# Скопируйте в config.env и заполните. config.env не попадает в git.

# --- Cloudflare -------------------------------------------------------------
# Account ID: панель Cloudflare → Workers & Pages → справа «Account ID».
CLOUDFLARE_ACCOUNT_ID=
# API-токен с правами из HOWTO (раздел «Cloudflare»).
CLOUDFLARE_API_TOKEN=

# --- Бот и группа -------------------------------------------------------------
# Имя воркера и базы данных в Cloudflare (латиница, цифры, дефис).
# Адрес бота будет https://<WORKER_NAME>.<ваш-поддомен>.workers.dev
WORKER_NAME=tg-gatekeeper
# Группа: @username для публичной группы или числовой ID (-100…) для закрытой.
# Числовой ID закрытой группы покажет scripts/find-chat.sh.
GROUP=@my_group

# --- Правила проверки -------------------------------------------------------
# Сколько неверных ответов допускается до вечного бана.
MAX_ATTEMPTS=3
# Через сколько часов удалять из группы тех, кто так и не ответил.
# Удалённый может вступить снова; использованные попытки сохраняются.
REMOVE_AFTER_HOURS=48
# Доля букв в тексте вопроса, заменяемых латинскими двойниками (а→a, о→o…),
# чтобы сбить ботов, ищущих ответ по тексту. 0 — выключено.
OBFUSCATE_RATE=0.25
# Только для групп с темами: ID темы для приветствия. Пусто — тема «Общее».
# ID — число в конце ссылки на тему: t.me/<группа>/<ID>.
PROMPT_THREAD_ID=
